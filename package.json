{
  "name": "ai-wolf-apk",
  "version": "1.0.0",
  "private": true,
  "description": "把 AI 狼人杀 PWA 用 Capacitor 打包成安卓 APK",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "render:icon": "node scripts/render-icon.mjs",
    "stamp": "node scripts/stamp-build.mjs",
    "build:hot": "node scripts/make-hot-bundle.mjs",
    "test": "npm run test:actions && npm run test:night-resume && npm run test:english-ui && npm run test:match-replay && npm run test:fox-info && npm run test:hot-update",
    "test:hot-update": "node scripts/test-hot-update.mjs",
    "test:actions": "node scripts/test-action-protocol.mjs",
    "test:night-resume": "node scripts/test-night-resume.mjs",
    "test:english-ui": "node scripts/test-english-ui.mjs",
    "test:match-replay": "node scripts/test-match-replay.mjs",
    "test:fox-info": "node scripts/test-fox-private-info.mjs",
    "art:modes": "node scripts/make-mode-art.mjs",
    "art:roles": "node scripts/optimize-role-art.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capgo/capacitor-updater": "^6.50.2"
  }
